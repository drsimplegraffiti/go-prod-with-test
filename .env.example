APP_ENV=development
PORT=8080

DATABASE_URL=postgres://postgres:postgres@localhost:5432/goapi?sslmode=disable

# Must be at least 32 random characters in production.
JWT_SECRET=dev-only-insecure-secret-change-me-please
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h

HTTP_READ_TIMEOUT=5s
HTTP_WRITE_TIMEOUT=10s
HTTP_IDLE_TIMEOUT=120s
HTTP_SHUTDOWN_TIMEOUT=15s

BCRYPT_COST=12
RATE_LIMIT_RPS=10
